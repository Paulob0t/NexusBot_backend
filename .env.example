# =============================================================================
# NEXUSBOT CRM - ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y asigna los valores correspondientes
# =============================================================================

# --- ENTORNO ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=tu_clave_secreta_aqui
JWT_SECRET_KEY=tu_clave_secreta_jwt_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- BASE DE DATOS PRINCIPAL (PostgreSQL en Podman / Local) ---
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=nexusbot_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/nexusbot_db

# --- BACKEND API (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180","http://localhost:5173","http://localhost:3000"]

# --- CORREO SALIENTE (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USER=servicios@ejemplo.com
SMTP_PASS=tu_password_smtp
SMTP_FROM_EMAIL=servicios@ejemplo.com
SMTP_FROM_NAME=NexusBot CRM
